# Nginx для фронта: раздаёт собранное приложение и проксирует /api на бэкенд.
#
# Это шаблон: при старте контейнера образ nginx подставляет сюда переменные
# окружения (${API_UPSTREAM}, ${NGINX_RESOLVER}) и кладёт результат в conf.d.
# Переменные самого nginx ($host, $uri, …) не трогаются — их нет в окружении.
#
# Фронт и API отдаются с одного адреса, поэтому cookie авторизации работают
# без CORS и без SameSite=None.

server {
    listen 8080;
    server_name _;
    root /usr/share/nginx/html;

    server_tokens off;
    # Редиректы nginx — относительные: снаружи порт может быть любым (8080, 443…).
    absolute_redirect off;

    # До трёх фото по 15 МБ в одной заявке на генерацию + поля формы.
    client_max_body_size 50m;

    gzip on;
    gzip_comp_level 5;
    gzip_min_length 1024;
    gzip_types text/css application/javascript application/json image/svg+xml;

    # Адрес API резолвится при каждом запросе (раз в 10 с), а не один раз при
    # старте: после перезапуска контейнера api у него новый IP, и со статичным
    # proxy_pass nginx слал бы запросы в никуда до собственного перезапуска.
    resolver ${NGINX_RESOLVER} valid=10s ipv6=off;
    set $api_upstream http://${API_UPSTREAM};

    location /api/ {
        proxy_pass $api_upstream;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        # Загрузка крупных фото по медленной сети и скачивание результата.
        proxy_read_timeout 120s;
        proxy_send_timeout 120s;
        include /etc/nginx/snippets/security-headers.conf;
    }

    # Файлы сборки с хешем в имени: содержимое по этому адресу никогда не
    # меняется, браузер может держать их в кеше год.
    location /assets/ {
        try_files $uri =404;
        add_header Cache-Control "public, max-age=31536000, immutable" always;
        include /etc/nginx/snippets/security-headers.conf;
    }

    # Для docker healthcheck.
    location = /healthz {
        access_log off;
        default_type text/plain;
        return 200 "ok\n";
    }

    # Всё остальное — маршруты SPA (/projects, /admin…): отдаём index.html,
    # дальше разбирается React Router. index.html не кешируем, иначе после
    # деплоя браузер держал бы ссылки на старые файлы сборки.
    location / {
        try_files $uri /index.html;
        add_header Cache-Control "no-cache" always;
        include /etc/nginx/snippets/security-headers.conf;
    }
}
