# Продакшен. На сервере: cp deploy/env.production.example .env и заполнить.
# Секреты генерировать, а не придумывать: команды указаны рядом.

# Подключает продакшен-надстройку ко всем командам `docker compose`.
COMPOSE_FILE=compose.yaml:compose.prod.yaml

# --- Домен ---
# Все три строки — с вашим доменом, https и без слеша в конце.
APP_CONFIG__AUTH__FRONTEND_URL=https://example.ru
APP_CONFIG__GOOGLE__REDIRECT_URI=https://example.ru/api/auth/google/callback
APP_CONFIG__AUTH__COOKIE_SECURE=true

# --- Секреты ---
# openssl rand -hex 32
APP_CONFIG__AUTH__SECRET_KEY=
APP_CONFIG__GOOGLE__CLIENT_ID=
APP_CONFIG__GOOGLE__CLIENT_SECRET=

# --- Генерация ---
APP_CONFIG__GENERATION__BACKEND=gemini
APP_CONFIG__GENERATION__WELCOME_CREDITS=1
APP_CONFIG__GEMINI__API_KEY=
APP_CONFIG__GEMINI__MODEL=gemini-3-pro-image
APP_CONFIG__GEMINI__IMAGE_SIZE=2K

# --- Хранилище (S3 в России, бакет приватный) ---
APP_CONFIG__STORAGE__BACKEND=s3
APP_CONFIG__STORAGE__S3__ENDPOINT_URL=https://storage.yandexcloud.net
APP_CONFIG__STORAGE__S3__REGION=ru-central1
APP_CONFIG__STORAGE__S3__BUCKET=
APP_CONFIG__STORAGE__S3__ACCESS_KEY_ID=
APP_CONFIG__STORAGE__S3__SECRET_ACCESS_KEY=
APP_CONFIG__STORAGE__S3__KEY_PREFIX=prod
# Хост из ENDPOINT_URL без https:// — к нему воркер ходит напрямую, мимо прокси.
S3_HOST=storage.yandexcloud.net

# --- Очередь и логи ---
APP_CONFIG__QUEUE__BACKEND=arq
APP_CONFIG__QUEUE__MAX_CONCURRENT_GENERATIONS=4
APP_CONFIG__LOGGING__LEVEL=INFO
APP_CONFIG__DB__ECHO=false

# --- Postgres ---
POSTGRES_USER=detailing
# Только латиница и цифры: openssl rand -hex 24
POSTGRES_PASSWORD=
POSTGRES_DB=detailing

# Сайт для nginx хоста (только 127.0.0.1, снаружи недоступен).
WEB_PORT=8080
