APP_CONFIG__DB__URL=postgresql+asyncpg://postgres:password@localhost:5432/detailing
APP_CONFIG__DB__ECHO=true

APP_CONFIG__LOGGING__LEVEL=INFO

APP_CONFIG__GEMINI__API_KEY=
APP_CONFIG__GEMINI__MODEL=gemini-3-pro-image

# gemini — настоящая генерация fake — заглушка для разработки
APP_CONFIG__GENERATION__BACKEND=fake
APP_CONFIG__GENERATION__FREE_DAILY_LIMIT=3

APP_CONFIG__STORAGE__BACKEND=local

APP_CONFIG__REDIS__URL=redis://localhost:6379/0
# arq — очередь в Redis + отдельный воркер (arq app.worker.WorkerSettings)
# background — внутри процесса API, без Redis (только для разработки)
APP_CONFIG__QUEUE__BACKEND=arq
APP_CONFIG__QUEUE__MAX_CONCURRENT_GENERATIONS=4

APP_CONFIG__GOOGLE__CLIENT_ID=
APP_CONFIG__GOOGLE__CLIENT_SECRET=
APP_CONFIG__AUTH__SECRET_KEY=
APP_CONFIG__AUTH__COOKIE_SECURE=false
APP_CONFIG__AUTH__FRONTEND_URL=http://localhost:5173


POSTGRES_USER=detailing
POSTGRES_PASSWORD=change-me
POSTGRES_DB=detailing
API_PORT=8001
