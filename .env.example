APP_CONFIG__DB__URL=postgresql+asyncpg://postgres:password@localhost:5432/detailing
APP_CONFIG__DB__ECHO=true

APP_CONFIG__LOGGING__LEVEL=INFO

APP_CONFIG__GEMINI__API_KEY=
APP_CONFIG__GEMINI__MODEL=gemini-3-pro-image

# gemini — настоящая генерация fake — заглушка для разработки
APP_CONFIG__GENERATION__BACKEND=fake
# Сколько генераций дарим при регистрации
APP_CONFIG__GENERATION__WELCOME_CREDITS=1

# local — папка storage (разработка), s3 — S3-совместимое хранилище (продакшен)
APP_CONFIG__STORAGE__BACKEND=local
# Пример для Yandex Object Storage. Бакет должен быть приватным:
# файлы отдаются только по временным подписанным ссылкам.
# APP_CONFIG__STORAGE__S3__ENDPOINT_URL=https://storage.yandexcloud.net
# APP_CONFIG__STORAGE__S3__REGION=ru-central1
# APP_CONFIG__STORAGE__S3__BUCKET=
# APP_CONFIG__STORAGE__S3__ACCESS_KEY_ID=
# APP_CONFIG__STORAGE__S3__SECRET_ACCESS_KEY=
# APP_CONFIG__STORAGE__S3__KEY_PREFIX=prod

APP_CONFIG__REDIS__URL=redis://localhost:6379/0
# arq — очередь в Redis + отдельный воркер (arq app.worker.WorkerSettings)
# background — внутри процесса API, без Redis (только для разработки)
APP_CONFIG__QUEUE__BACKEND=arq
APP_CONFIG__QUEUE__MAX_CONCURRENT_GENERATIONS=4

APP_CONFIG__GOOGLE__CLIENT_ID=
APP_CONFIG__GOOGLE__CLIENT_SECRET=
APP_CONFIG__AUTH__SECRET_KEY=
APP_CONFIG__AUTH__COOKIE_SECURE=false
APP_CONFIG__AUTH__FRONTEND_URL=http://localhost:5173

# --- Docker Compose ---
# Используются только в compose.yaml. Адреса базы и Redis для контейнеров
# compose задаёт сам, строки APP_CONFIG__DB__URL и REDIS__URL выше для запуска без Docker.
POSTGRES_USER=detailing
# Только латиница и цифры: пароль подставляется в URL базы без экранирования.
POSTGRES_PASSWORD=change-me
POSTGRES_DB=detailing
API_PORT=8001
# Сайт целиком (фронт + /api через Nginx): http://localhost:8080.
# Открываете сайт отсюда — поставьте APP_CONFIG__AUTH__FRONTEND_URL=http://localhost:8080,
# чтобы после входа через Google вернуться сюда. Для разработки через Vite — 5173.
WEB_PORT=8080
